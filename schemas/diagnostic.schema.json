{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubohiroya.github.io/turbowarp-diagnostic-overlay/schemas/diagnostic.schema.json",
  "type": "object",
  "required": [
    "severity",
    "code",
    "message"
  ],
  "properties": {
    "severity": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "detail": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "column": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "excerpt": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}

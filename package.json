{
  "name": "@kubohiroya/turbowarp-diagnostic-overlay",
  "version": "0.8.0",
  "description": "Render structured diagnostics as safe SVG overlays on the TurboWarp stage.",
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "diagnostics",
    "svg",
    "overlay"
  ],
  "author": {
    "name": "Hiroya Kubo",
    "email": "hiroya@cuc.ac.jp",
    "url": "https://github.com/kubohiroya"
  },
  "license": "MPL-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-diagnostic-overlay.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-diagnostic-overlay/issues"
  },
  "homepage": "https://kubohiroya.github.io/turbowarp-diagnostic-overlay/",
  "files": [
    "assets/",
    "dist/",
    "docs/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "schemas/"
  ],
  "main": "./dist/lib/composition.js",
  "types": "./dist/lib/composition.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/composition.d.ts",
      "import": "./dist/lib/composition.js"
    },
    "./composition": {
      "types": "./dist/lib/composition.d.ts",
      "import": "./dist/lib/composition.js"
    },
    "./diagnostic": {
      "types": "./dist/lib/diagnostic.d.ts",
      "import": "./dist/lib/diagnostic.js"
    },
    "./svg-renderer": {
      "types": "./dist/lib/svg-renderer.d.ts",
      "import": "./dist/lib/svg-renderer.js"
    },
    "./dist/diagnostic-overlay.js": "./dist/diagnostic-overlay.js",
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/diagnostic-overlay.js",
  "jsdelivr": "./dist/diagnostic-overlay.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/copy-editor-schema.mjs",
    "lint": "eslint src tests scripts vite.config.ts vitest.config.ts",
    "format": "eslint src tests scripts vite.config.ts vitest.config.ts --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit": "pnpm audit --prod --audit-level high",
    "docs": "node scripts/generate-readme.ts && node scripts/generate-fixed-input-docs.mjs",
    "docs:check": "node scripts/generate-readme.ts --check && node scripts/generate-fixed-input-docs.mjs --check",
    "site:check": "node scripts/check-site.ts",
    "check:dist": "pnpm run build && git diff --exit-code -- dist",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "release:check": "npm publish --dry-run --access public --ignore-scripts",
    "repo:check": "node scripts/check-repo.ts",
    "check": "pnpm run audit && pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build && pnpm run docs:check && pnpm run site:check && pnpm run check:dist && pnpm run repo:check && pnpm run pack:check && pnpm run samples:check",
    "prepublishOnly": "pnpm run check",
    "samples:build": "node scripts/build-samples.mjs",
    "samples:check": "node scripts/build-samples.mjs --check && node --test scripts/verify-samples.mjs",
    "pages:build": "node scripts/prepare-pages.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@kubohiroya/turbowarp-extension-manifest": "^0.5.0",
    "@kubohiroya/vite-plugin-turbowarp-extension": "^0.10.0",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "react-dom": "18.3.1"
  },
  "dependencies": {
    "@kubohiroya/turbowarp-extension-data-editor": "^0.5.0"
  },
  "gitHead": "f5d15bcc0d3b23517359a789b644599dfba4397f",
  "x-turbowarp-source": {
    "revision": "f5d15bcc0d3b23517359a789b644599dfba4397f",
    "revisionRole": "base-commit",
    "sourceState": "local-release-overlay"
  }
}
